{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "wallpaper-bar",
  "version": "1.0.0",
  "description": "GlazeWM workspaces and wallpaper-derived Matugen colors.",
  "tags": [
    "topbar"
  ],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File C:\\\\Users\\\\Matthew\\\\Personal\\\\dotfiles\\\\\\.config\\\\zebar\\\\wallpaper\\.ps1$"
          },
          {
            "program": "C:\\Users\\Matthew\\Personal\\dotfiles\\.config\\zebar\\watch-virtual-desktop.exe",
            "argsRegex": "^$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "36px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
